# AWS Credentials for Bedrock Access
# Configure these using: aws configure
# Or set them here (not recommended - use AWS CLI instead)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_DEFAULT_REGION=us-east-1

# Shopify Agent Configuration
# Update agenteval.yml with your actual values
SHOPIFY_AGENT_URL=https://localhost:3458
SHOPIFY_SHOP_DOMAIN=https://your-store.myshopify.com
SHOPIFY_SHOP_ID=your-shop-id